# ==============================
# 赤光社 RedLight 环境变量示例
# 复制为 .env 后按需修改；本文件不会提交任何真实密钥。
# ==============================

# ---------- 服务 ----------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true
CORS_ORIGIN=*
# 生产环境务必替换为足够长的随机字符串
JWT_SECRET=redlight-dev-secret-please-change
JWT_EXPIRES_IN=7d

# ---------- 门店管理后台 ----------
# 第一级统一密码：所有门店后台共用，部署前务必改成强密码
ADMIN_GATE_PASSWORD=redlight-admin-gate
# 管理员个人登录态有效期
ADMIN_TOKEN_EXPIRES_IN=2h
# 可选：首次启动自动创建门禁账号 admin1001 / admin1002（留空则不创建）
ADMIN_BOOTSTRAP_PASSWORD=

# ---------- 数据库 ----------
# 本地零依赖：sqlite；Docker/线上：mysql
DB_DRIVER=sqlite
# SQLite 文件路径（相对 server/ 目录；也可写绝对路径）
DB_FILE=data/redlight.db

# MySQL（DB_DRIVER=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=redlight_root_password
DB_NAME=redlight

# ---------- 缓存 ----------
# 留空时使用进程内 TTL 缓存（本地开发）；配置后使用 Redis
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379

# ---------- 邮件（QQ/163 SMTP）----------
# 不配置 SMTP_HOST 时进入 console 模式：验证码打印到后端控制台，
# 且非生产环境接口会返回 devCode，方便本地联调。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# 注意：这里是邮箱 SMTP 授权码，不是邮箱登录密码
SMTP_PASS=
SMTP_FROM=

# ---------- 上传目录 ----------
# 相对 server/ 目录
UPLOAD_DIR=uploads

# ---------- 前端开发 ----------
# 前端 Vite 开发服务器代理到后端
VITE_PROXY_TARGET=http://127.0.0.1:3000

# ---------- Docker Compose ----------
DB_PASSWORD=redlight_root_password
API_PORT=3000
WEB_PORT=80
